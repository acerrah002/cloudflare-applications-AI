{
  "name": "hello-world",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uno-db",
      "database_id": "0e427a77-b967-4c5a-91bc-946308f31410"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby"] }
  ]
}