{
  "name": "green-button",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BUTTON", "class_name": "Button" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Button"] }]
}