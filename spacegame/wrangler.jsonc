{
  "name": "spacegame",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [ { "name": "ROOM", "class_name": "Room" } ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}